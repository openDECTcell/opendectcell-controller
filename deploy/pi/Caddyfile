# The TLS front of the test ground's web interface. Caddy gets and renews the certificate from Let's Encrypt by itself (the
# challenge runs over IPv6: the name has no A record), redirects http to https and passes the requests to the controller on
# 127.0.0.1:8080, which sees the visitor's address in X-Forwarded-For (it trusts this proxy, see docker-compose.pi.yml).
{
	# ACME_CA in .env switches to the staging authority while trying things: its certificates are not trusted, its limits are generous
	acme_ca {$ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
	# HTTP/3 would need UDP 443 open as well; it adds nothing here
	servers {
		protocols h1 h2
		# the controller's own timeouts only guard the leg behind this proxy; a client that dribbles a request in must
		# not hold a connection open on the public side
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
	# no management API
	admin off
}

{$OPENDECTCELL_HOST:opendectcell.example.org} {
	encode zstd gzip
	header -Server
	# the operator's endpoints are for the host itself (the health check and Prometheus scrape 127.0.0.1:8080), not the internet
	@internal path /metrics /metrics/* /healthz /readyz
	respond @internal 404
	reverse_proxy 127.0.0.1:8080
}
